{
  "extends": "@tsconfig/node24/tsconfig.json",

  "include": ["e2e/**/*"],

  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",

    // Playwright drives a real browser, so specs reference DOM types
    // alongside Node's.
    "lib": ["ESNext", "DOM"],
    "types": ["node"],

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
